{
  "name": "@dmoove/cdk-gitlab-runner",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmoove/cdk-gitlab-runner"
  },
  "scripts": {
    "bundle": "node scripts/bundle-lambdas.mjs",
    "compile": "tsc -p tsconfig.json && npm run bundle",
    "docgen": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "lint": "eslint src test scripts",
    "lint:fix": "eslint src test scripts --fix",
    "format": "prettier --write \"**/*.{ts,mjs,js,json,md}\"",
    "clean": "rimraf lib dist coverage lambda docs test-reports",
    "version": "changeset version",
    "release": "changeset publish",
    "release:ci": "npm run build && npm run release",
    "pretest": "npm run bundle",
    "test": "jest --runInBand --ci --detectOpenHandles --passWithNoTests --coverageProvider=v8 && npm run lint",
    "build": "npm run compile && npm test"
  },
  "author": {
    "name": "Yannick Tresch",
    "email": "yannick.tresch@dmoove.com",
    "organization": true
  },
  "devDependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1136.0",
    "@aws-sdk/client-cloudwatch": "^3.1136.0",
    "@aws-sdk/client-ec2": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^29.5.12",
    "@types/node": "^22",
    "aws-cdk-lib": "2.270.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-junit": "^16",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.169.0",
    "constructs": "^10.0.5"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  },
  "keywords": [
    "aws",
    "cdk",
    "cdk-constructs",
    "gitlab",
    "runner"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/lambda/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.eslint.json",
          "isolatedModules": true
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "awscdkio": {
    "twitter": "yanu23"
  },
  "files": [
    "lib",
    "lambda",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
